{
  "name": "prometheus-backend",
  "version": "0.0.1",
  "description": "Standalone backend for the Prometheus operations app",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:superadmin": "node scripts/ensure-superadmin.js",
    "seed:local-demo": "node scripts/seed-local-demo.js",
    "smoke:helper-crew": "node scripts/run-local-helper-smoke.js",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/websockets": "^10.4.22",
    "@socket.io/admin-ui": "^0.5.0",
    "@socket.io/cluster-adapter": "^0.2.0",
    "@socket.io/sticky": "^1.0.1",
    "@types/node-fetch": "2.6.12",
    "axios": "^1.14.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.4",
    "date-fns": "2.28.0",
    "fast-xml-parser": "^5.2.5",
    "fs-extra": "10.0.0",
    "mammoth": "^1.12.0",
    "mongoose": "^8.23.0",
    "nestjs-stripe": "^1.0.0",
    "node-fetch": "2.6.13",
    "nodemailer": "6.7.2",
    "openai": "^6.33.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "7.5.5",
    "stripe": "^10.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "4.17.13",
    "@types/fs-extra": "9.0.13",
    "@types/jest": "27.4.1",
    "@types/multer": "^1.4.13",
    "@types/node": "17.0.23",
    "@types/nodemailer": "6.4.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.16",
    "jest": "27.5.1",
    "prettier": "2.6.0",
    "supertest": "6.2.2",
    "ts-jest": "27.1.3",
    "ts-loader": "9.2.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "typescript": "4.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
