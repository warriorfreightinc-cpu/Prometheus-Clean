# Local test database
DB_URI=mongodb://127.0.0.1:27017/prometheus_local

# Legacy remote database fields kept for fallback compatibility
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_CLUSTER_NAME=
DATABASE_NAME=prometheus_local

PROJECT_NAME=Prometheus
APP_URL=http://localhost:4300
SUPPORT_EMAIL=support@prometheus.local
SUPPORT_PHONE=(847) 230-7236

JWT_SECRET=prometheus_backend_local_jwt_secret_change_me
JWT_EXPIRATION=30d

# Optional local SMTP for testing emails, for example Mailpit on localhost:1025
MAIL_USER=test
MAIL_PASSWORD=test
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_PORT_SECURE=0

# Optional local/test Stripe placeholders
STRIPE_API_KEY=sk_test_local_placeholder
STRIPE_WEBHOOKS_KEY=whsec_local_placeholder
STRIPE_RETURN_URL=http://localhost:4300/workspace

API_PORT=3100

# Must stay 32 characters for current AES usage
SIGNATURE_KEY=12345678901234567890123456789012

# Add your real Google Maps API key here if you want map/geocoding features locally
AgmCoreModule=
GOOGLE_MAPS_API_KEY=

# Authority verification. Use "off" only for local testing when the public authority data endpoint is unavailable.
FMCSA_AUTHORITY_VALIDATION=datahub

# Optional document storage for production authority files and setup/accessorial paperwork
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional provider connector references. Store real secrets in a vault/secret manager in production.
# Local sandbox provider previews. Set to 0/off when real provider credentials are connected.
PROMETHEUS_SANDBOX_PROVIDERS=1
HIGHWAY_API_KEY=
MYCARRIERPACKET_API_KEY=
TRUCKSTOP_API_KEY=
DAT_API_KEY=
CH_ROBINSON_API_KEY=
TQL_API_KEY=
MACROPOINT_API_KEY=
FOURKITES_API_KEY=
SAMSARA_API_TOKEN=
MOTIVE_API_KEY=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=

# Brain Pro local LM Studio / OpenAI-compatible settings.
# Keep OPENAI_BASE_URL set for local testing.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=openai_gpt-oss-20b-wcb

# Brain Pro cloud OpenAI settings.
# For Prometheus-managed cloud mode, clear OPENAI_BASE_URL and set a server-side API key.
# Company-owned keys are entered by admins in Company Setup and are never returned to the frontend.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=your_real_openai_api_key
# OPENAI_MODEL=gpt-5.5
